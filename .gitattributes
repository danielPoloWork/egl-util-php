# Normalize line endings to LF in the repository regardless of a contributor's local
# core.autocrlf setting. Prevents PHP-CS-Fixer / PHPStan from reporting spurious
# line-ending diffs on Windows checkouts (git stores LF; CI runs on Linux, which
# already checks out LF by default).
* text=auto eol=lf

# --- Packagist dist hygiene (issue #119) ---------------------------------------------
#
# `export-ignore` only affects what `composer create-project`/Packagist's dist archive
# contains, never a full `git clone` — nothing here removes a file from the repository
# or from CI. Everything a consumer needs is: the autoloaded source (`src/main`),
# `composer.json`, `LICENSE`, and `README.md` for the page Packagist itself renders.
# Silence rather than a positive list, because the alternative (allowlisting src/main
# only) breaks the moment a new top-level file is added and nobody remembers this rule.
#
# Verify with: git archive HEAD | tar -t
/.eados-core export-ignore
/.github export-ignore
/.specs export-ignore
/orchestrator export-ignore
/packages export-ignore
/src/bench export-ignore
/src/test export-ignore
/tools export-ignore
/.php-cs-fixer.dist.php export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/GEMINI.md export-ignore
/ISSUES.md export-ignore
/ROADMAP.md export-ignore
/SECURITY.md export-ignore
/CHANGELOG.md export-ignore
/composer.lock export-ignore
/deptrac.yaml export-ignore
/infection.json5 export-ignore
/phpbench.json.dist export-ignore
/phpstan.neon export-ignore
/phpunit.xml.dist export-ignore
/docs export-ignore
