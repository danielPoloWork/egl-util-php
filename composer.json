{
    "name": "egl/utils",
    "description": "General-purpose PHP utility helpers shared across EGL projects",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "utilities",
        "dto",
        "psr-11",
        "security",
        "pdo"
    ],
    "authors": [
        {
            "name": "Daniel Polo"
        }
    ],
    "homepage": "https://github.com/danielPoloWork/egl-util-php",
    "support": {
        "issues": "https://github.com/danielPoloWork/egl-util-php/issues",
        "source": "https://github.com/danielPoloWork/egl-util-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.44",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpbench/phpbench": "^1.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "D4np\\Utils\\": "src/main/php/d4np/utils/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "D4np\\Utils\\Bench\\": "src/bench/php/d4np/utils/",
            "D4np\\Utils\\Tests\\": "src/test/php/d4np/utils/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "audit": {
            "abandoned": "report"
        },
        "platform": {
            "php": "8.1.34"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
