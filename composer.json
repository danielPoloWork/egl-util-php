{
    "name": "egl/utils",
    "description": "General-purpose PHP utility helpers shared across EGL projects",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "utilities",
        "dto",
        "psr-11",
        "security",
        "pdo"
    ],
    "authors": [
        {
            "name": "Daniel Polo"
        }
    ],
    "homepage": "https://github.com/danielPoloWork/egl-util-php",
    "support": {
        "issues": "https://github.com/danielPoloWork/egl-util-php/issues",
        "source": "https://github.com/danielPoloWork/egl-util-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "D4np\\Utils\\": "src/main/php/d4np/utils/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "D4np\\Utils\\Tests\\": "src/test/php/d4np/utils/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
