<?xml version="1.0" encoding="UTF-8"?>
<!--
  phpDocumentor configuration for the API reference (issue #107, ROADMAP 13.7).

  AGENTS.md §10 has listed "phpDocumentor builds without warnings" as a mandatory gate since the
  repository was generated, with no config, no dependency, no CI job and no published output
  anywhere. This file is half of making that claim true; `.github/workflows/api-docs.yml` and
  `tools/api_docs_gate.py` are the other half.

  Scope is `src/main` only, deliberately. `src/test` and `src/bench` are not a public surface and
  documenting them would bury the 117 classes a consumer actually calls.
-->
<phpdocumentor
    configVersion="3"
    xmlns="https://www.phpdoc.org/xsd/phpdoc-configuration-3.0.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://www.phpdoc.org/xsd/phpdoc-configuration-3.0.xsd">

    <title>egl/utils API reference</title>
    <paths>
        <output>build/api</output>
        <cache>build/.phpdoc-cache</cache>
    </paths>

    <version number="1.0.0">
        <api>
            <source dsn=".">
                <path>src/main/php/d4np/utils</path>
            </source>
            <output>.</output>
        </api>
    </version>
</phpdocumentor>
